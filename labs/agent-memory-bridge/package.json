{
  "name": "@driftglass/agent-memory-bridge",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Optional Cloudflare Agent Memory bridge for approved Driftglass memory checkpoints",
  "scripts": {
    "dev": "wrangler dev --remote",
    "typecheck": "tsc --noEmit",
    "typecheck:offline": "tsc -p tsconfig.offline.json --noEmit",
    "deploy": "npm run typecheck && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260807.2",
    "typescript": "5.8.3",
    "wrangler": "4.123.0"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents": false,
    "workerd@1.20260801.1": true
  },
  "license": "MIT"
}
