{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftglass.dev/lenses/schema.json",
  "title": "Driftglass Lens",
  "description": "Portable sources, Research Missions, schedules, and interests for Driftglass.",
  "type": "object",
  "additionalProperties": true,
  "required": ["driftglassLens", "id", "name", "description", "sources"],
  "properties": {
    "driftglassLens": { "const": "1" },
    "id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "name": { "type": "string", "minLength": 1, "maxLength": 180 },
    "description": { "type": "string", "maxLength": 2000 },
    "author": { "type": "string", "maxLength": 180 },
    "homepage": { "type": "string", "format": "uri" },
    "category": { "type": "string", "maxLength": 100 },
    "icon": { "type": "string", "maxLength": 12 },
    "requiresCompanion": { "type": "boolean" },
    "interestTerms": { "type": "array", "maxItems": 300, "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "config", "scheduleMinutes", "weight"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": {
            "enum": ["hackernews", "lobsters", "bluesky", "arxiv", "openalex", "github_releases", "github_activity", "npm_releases", "pypi_releases", "web", "web_feed", "collector", "manual", "email"]
          },
          "config": { "type": "object" },
          "scheduleMinutes": { "type": "number", "minimum": 15, "maximum": 10080 },
          "weight": { "type": "number", "minimum": 0.1, "maximum": 3 },
          "enabled": { "type": "boolean" }
        }
      }
    },
    "missions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "question": { "type": "string" },
          "terms": { "type": "array", "items": { "type": "string" } },
          "sourceScope": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["active", "paused", "complete"] },
          "priority": { "type": "number", "minimum": 0.1, "maximum": 5 },
          "cadenceMinutes": { "type": "number", "minimum": 15, "maximum": 43200 }
        }
      }
    }
  }
}
