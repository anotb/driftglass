  "distribution": {
    "publicCards": "/share/{share-token}",
    "lensCatalog": "/lenses/catalog.json",
    "intelligencePackCatalog": "/intelligence-packs/catalog.json",
    "intelligencePackSchema": "/intelligence-packs/schema.json",
    "dropCapsules": "/share/{share-token}/drop.zip"
