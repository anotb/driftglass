    "decisions": "/api/decisions",
    "routines": "/api/routines",
    "sourceScorecards": "/api/source-scorecards",
    "evidenceLineage": "/api/evidence/lineage",
    "adaptiveCadence": "/api/sources/cadence",
    "runtimeFabric": "/api/runtime",
    "livingDossiers": "/api/dossiers",
    "memoryCheckpoints": "/api/memory/checkpoints",
    "decisionLedger": "/api/decisions"
