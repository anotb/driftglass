{
  "name": "Driftglass",
  "version": "0.9.0",
  "description": "Personal intelligence for standing questions: selected sources become developing Stories, current source-linked answers, connected memory, decisions, forecasts, Intelligence Packs, and one workspace per Mission.",
  "documentation": "/llms-full.txt",
  "installation": "/install.md",
  "openapi": "/openapi.json",
  "health": "/health",
  "mcp": {
    "transport": "streamable-http",
    "defaultProfile": "reasoning",
    "pathTemplate": "/mcp",
    "legacyPathTemplate": "/mcp/{private-read-key}",
    "operationsPathTemplate": "/mcp/{private-operations-key}/ops",
    "reasoning": {
      "readOnly": true,
      "purpose": "Answer standing questions with current source-linked judgments, cited briefs, investigation, Mission and memory recall, and prepared reasoning tasks.",
      "tools": [
        "brief_today",
        "brief_mission",
        "present_brief",
        "open_today",
        "next_reasoning_task",
        "prepare_context",
        "prepare_personal_context",
        "search",
        "find_missions",
        "fetch",
        "get_mission",
        "recall_memory",
        "compare_memory",
        "explain_story",
        "get_action_center",
        "get_system_health",
        "list_intelligence_packs"
      ]
    },
    "operations": {
      "readOnly": false,
      "purpose": "Explicit state changes and system operation.",
      "tools": [
        "brief_today",
        "brief_mission",
        "present_brief",
        "open_today",
        "search",
        "semantic_search",
        "get_semantic_memory_status",
        "sync_semantic_memory",
        "fetch",
        "explain_ranking",
        "get_personalization_profile",
        "get_story_graph",
        "get_story_timeline",
        "get_latest_briefing",
        "list_research_missions",
        "list_mission_sprints",
        "get_research_mission",
        "prepare_deep_research",
        "record_mission_update",
        "get_action_center",
        "get_mission_autopilot",
        "run_mission_sprint",
        "list_pending_research_results",
        "stage_research_result",
        "decide_research_result",
        "open_mission_computer",
        "sync_mission_computer",
        "read_mission_file",
        "search_mission_computer",
        "write_mission_note",
        "export_mission_computer",
        "inspect_public_page",
        "get_source_health",
        "get_relay_capability_catalog",
        "recall_memory",
        "get_memory_timeline",
        "get_memory_graph_health",
        "audit_memory_integrity",
        "prepare_reasoning_context",
        "stage_memory_patch",
        "list_memory_proposals",
        "decide_memory_proposal",
        "list_intelligence_packs",
        "check_intelligence_pack_updates",
        "preview_intelligence_pack",
        "update_intelligence_pack",
        "install_intelligence_pack",
        "get_judgment_queue",
        "prepare_reasoning_receipt",
        "record_reasoning_result",
        "review_reasoning_run",
        "create_decision_record",
        "review_decision_record",
        "create_memory_checkpoint",
        "run_intelligence_routine",
        "capture_pack_customizations"
      ]
    },
    "ui": [
      "ui://driftglass/briefing-v2.html",
      "ui://driftglass/editorial-brief-v9.html",
      "ui://driftglass/editorial-brief-v8.html"
    ]
  },
  "packets": {
    "daily": "/packet/{private-read-key}/latest.md",
    "pulse": "/packet/{private-read-key}/pulse.md",
    "mission": "/packet/{private-read-key}/mission/{mission-id}.md",
    "deepResearch": "/packet/{private-read-key}/mission/{mission-id}/deep-research.md"
  },
  "intelligence": {
    "memory": "/api/memory",
    "memoryHealth": "/api/memory/health",
    "memoryAudit": "/api/memory/audit",
