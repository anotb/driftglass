  "cloudflare": [
    "Workers",
    "Durable Objects",
    "Cloudflare Computer",
    "D1",
    "R2",
    "Queues",
    "Workflows",
    "Cron Triggers",
    "Agents SDK"
  ],
  "optional": [
    "Driftglass Companion for local Mission Computer mirroring",
    "Cloudflare Browser Rendering with Kitesurf and Chromium after the owner adds the optional binding",
    "OpenCLI Browser Bridge for optional signed-in browser sources",
    "Computer Power Mode with Worker-shell and Worker-JavaScript execution",
    "Email Workers intake after the owner configures Email Routing",
    "WebMCP browser tools after the owner enables the required Chrome origin trial or local testing flag",
    "Cloudflare AI Search semantic retrieval accelerator",
    "Cloudflare Agent Memory checkpoint bridge while the service remains private beta"
  ],
  "budgetProfiles": [
    "free",
    "cheap",
    "custom"
  ],
  "operations": {
    "actionCenter": "/api/action-center",
    "readinessDoctor": "/api/readiness",
    "autopilot": "/api/autopilot",
    "researchApprovalInbox": "/api/research-results",
    "missionComputer": "/api/missions/{mission-id}/computer",
    "memoryGraph": "/api/memory",
    "memoryAudit": "/api/memory/audit",
    "intelligencePacks": "/api/intelligence-packs",
    "reasoningCompiler": "/api/reasoning/compile",
    "budgetGovernor": "/api/budget",
    "memoryRefresh": "/api/memory/refresh",
    "judgment": "/api/judgment",
    "reasoningTasks": "/api/reasoning/tasks",
    "reasoningReceipts": "/api/reasoning/receipts",
    "decisionLedger": "/api/decisions",
    "intelligenceRoutines": "/api/routines",
    "sourceScorecards": "/api/source-scorecards",
    "adaptiveCadence": "/api/sources/cadence",
    "packOverlays": "/api/intelligence-packs/{pack-id}/overlays",
    "runtimeFabric": "/api/runtime",
    "livingDossiers": "/api/dossiers",
    "memoryCheckpoints": "/api/memory/checkpoints"
  },
  "reasoningInterfaces": {
    "chatgpt": {
      "default": "Driftglass plugin and OAuth MCP",
      "proactive": "Scheduled Tasks over bounded packets and prepared tasks",
      "deep": "Deep Research handoff when broader current-source discovery is required",
      "trace": "source-state receipt hash, citations, and saved answer"
    },
    "claude": {
      "default": "compact remote MCP",
      "portable": "Agent Skill and Markdown/JSON source context",
      "trace": "the same source-state receipt can be reused to compare another model's answer"
    },
    "grok": {
      "default": "source-state receipt or compact connector where supported",
      "portable": "Markdown/JSON interface kit",
      "trace": "model label recorded without creating an xAI API dependency"
    },
    "generic": "compact MCP or a source-linked context bundle with the Mission question, selected material, requested answer shape, and optional reviewed memory proposal"
  }
}
